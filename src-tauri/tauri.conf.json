{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kano PDF Tool",
  "version": "3.10.0",
  "identifier": "com.yufeng.kano-pdf-tool",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/IDK-Silver/PDF_Tool/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0N0Q0ODZFNDBFMkY2MzEKUldReDl1SkFia2g5dEZDZ21oR0dyK0pzMUd4TGY3SUlsdHUzNEtHNm54Yis4NWJMdWdOZEFqTmYK"
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kano PDF Tool",
        "width": 800,
        "height": 600,
        "minWidth": 900,
        "minHeight": 700,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "scope": [
          "$APP/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/pdfium/*/*"
    ],
    "macOS": {
      "entitlements": "macos/entitlements.plist",
      "signingIdentity": "Developer ID Application: Yu Feng Huang (S9782747Y9)"
    },
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "role": "Viewer",
        "description": "PDF file"
      },
      {
        "ext": ["png", "jpg", "jpeg", "gif", "bmp", "webp", "tiff", "tif", "svg"],
        "name": "Image File",
        "role": "Viewer",
        "description": "Image file"
      }
    ]
  }
}
