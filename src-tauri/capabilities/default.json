{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and about window",
  "windows": ["main", "about-window"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-size",
    "core:window:allow-show",
    "dialog:default",
    "opener:default",
    "fs:default",
    { "identifier": "fs:scope", "allow": [ { "path": "$HOME/**" }, { "path": "$APPCONFIG/**" } ] },
    { "identifier": "fs:allow-write-file", "allow": [ { "path": "$HOME/**" }, { "path": "$APPCONFIG/**" } ] }
  ]
}
